# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.idea
.DS_Store
static/icon.iconset
static/icon.icns
static/resources
*.pkg
*.app

# Native macOS shell: generated by `just apple-generate`, built by xcodebuild
apple/build/
apple/generated/
apple/*.xcodeproj
